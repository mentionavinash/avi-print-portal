/* =========================================
   AVIPRINT USER DASHBOARD
========================================= */

.dashboard-page {
    background: #f5f7fb;
}

.dashboard-container {
    width: 100%;
    min-height: calc(100vh - 76px);
    display: flex;
}


/* =========================================
   SIDEBAR
========================================= */

.dashboard-sidebar {
    width: 250px;
    min-width: 250px;
    min-height: calc(100vh - 76px);
    background: #ffffff;
    border-right: 1px solid #e5e7eb;
    display: flex;
    flex-direction: column;
    position: sticky;
    top: 76px;
    height: calc(100vh - 76px);
}

.sidebar-user {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 25px 20px;
    border-bottom: 1px solid #f1f5f9;
}

.user-avatar {
    width: 43px;
    height: 43px;
    min-width: 43px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: #2563eb;
    color: #ffffff;
    font-weight: 800;
}

.sidebar-user div:last-child {
    display: flex;
    flex-direction: column;
    min-width: 0;
}

.sidebar-user strong {
    font-size: 13px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.sidebar-user span {
    font-size: 11px;
    color: #9ca3af;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}


/* SIDEBAR NAV */

.sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 20px 13px;
}

.sidebar-nav a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border-radius: 9px;
    color: #6b7280;
    font-size: 13px;
    font-weight: 650;
    transition: 0.2s ease;
}

.sidebar-nav a span {
    width: 22px;
    text-align: center;
    font-size: 16px;
}

.sidebar-nav a:hover {
    background: #f3f6ff;
    color: #2563eb;
}

.sidebar-nav a.active {
    background: #eff6ff;
    color: #2563eb;
}


/* SIDEBAR BOTTOM */

.sidebar-bottom {
    margin-top: auto;
    padding: 20px;
    border-top: 1px solid #f1f5f9;
}

.sidebar-bottom a {
    color: #6b7280;
    font-size: 12px;
}

.sidebar-bottom a:hover {
    color: #2563eb;
}


/* =========================================
   DASHBOARD MAIN
========================================= */

.dashboard-main {
    flex: 1;
    min-width: 0;
    padding: 40px;
}


/* MOBILE DASHBOARD HEADER */

.dashboard-mobile-header {
    display: none;
}


/* =========================================
   DASHBOARD HEADING
========================================= */

.dashboard-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 25px;
    margin-bottom: 35px;
}

.dashboard-heading .section-label {
    margin-bottom: 8px;
}

.dashboard-heading h1 {
    font-size: 32px;
    letter-spacing: -1px;
    margin-bottom: 6px;
}

.dashboard-heading p {
    color: #6b7280;
    font-size: 13px;
}


/* =========================================
   STAT CARDS
========================================= */

.dashboard-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 17px;
    margin-bottom: 35px;
}

.stat-card {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 21px;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    transition: 0.25s ease;
}

.stat-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(17, 24, 39, 0.06);
}

.stat-icon {
    width: 45px;
    height: 45px;
    min-width: 45px;
    display: grid;
    place-items: center;
    border-radius: 11px;
    font-size: 19px;
}

.stat-icon.blue {
    background: #eff6ff;
}

.stat-icon.green {
    background: #ecfdf5;
}

.stat-icon.orange {
    background: #fff7ed;
}

.stat-icon.purple {
    background: #f5f3ff;
}

.stat-card div:last-child {
    display: flex;
    flex-direction: column;
}

.stat-card span {
    color: #9ca3af;
    font-size: 11px;
    margin-bottom: 2px;
}

.stat-card strong {
    font-size: 21px;
    color: #111827;
}


/* =========================================
   DASHBOARD SECTION
========================================= */

.dashboard-section {
    margin-bottom: 32px;
}

.section-title-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-bottom: 17px;
}

.section-title-row h2 {
    font-size: 18px;
    letter-spacing: -0.3px;
}

.section-title-row p {
    color: #9ca3af;
    font-size: 12px;
    margin-top: 3px;
}

.section-title-row > a {
    color: #2563eb;
    font-size: 12px;
    font-weight: 700;
}


/* =========================================
   DASHBOARD SERVICES
========================================= */

.dashboard-service-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
}

.dashboard-service-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 21px;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    transition: 0.25s ease;
}

.dashboard-service-card:hover {
    border-color: #bfdbfe;
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(17, 24, 39, 0.06);
}

.dashboard-service-icon {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    background: #eff6ff;
    border-radius: 11px;
    font-size: 20px;
    margin-bottom: 15px;
}

.dashboard-service-card strong {
    font-size: 13px;
    margin-bottom: 4px;
}

.dashboard-service-card span {
    color: #9ca3af;
    font-size: 11px;
}


/* =========================================
   EMPTY ORDERS
========================================= */

.orders-empty {
    padding: 55px 25px;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 15px;
    text-align: center;
}

.empty-icon {
    width: 60px;
    height: 60px;
    display: grid;
    place-items: center;
    margin: 0 auto 17px;
    background: #f3f4f6;
    border-radius: 50%;
    font-size: 26px;
}

.orders-empty h3 {
    font-size: 17px;
    margin-bottom: 7px;
}

.orders-empty p {
    color: #9ca3af;
    font-size: 12px;
    margin-bottom: 20px;
}

.orders-empty .primary-btn {
    display: inline-flex;
    width: auto;
}


/* =========================================
   DASHBOARD RESPONSIVE
========================================= */

@media (max-width: 1100px) {

    .dashboard-stats {
        grid-template-columns: repeat(2, 1fr);
    }

    .dashboard-service-grid {
        grid-template-columns: repeat(2, 1fr);
    }

}


@media (max-width: 900px) {

    .dashboard-sidebar {
        position: fixed;
        left: 0;
        top: 68px;
        bottom: 0;
        height: calc(100vh - 68px);
        z-index: 900;
        transform: translateX(-105%);
        transition: 0.3s ease;
        box-shadow: 15px 0 40px rgba(17, 24, 39, 0.08);
    }

    .dashboard-sidebar.open {
        transform: translateX(0);
    }

    .dashboard-main {
        width: 100%;
        padding: 25px;
    }

    .dashboard-mobile-header {
        display: flex;
        align-items: center;
        gap: 13px;
        margin-bottom: 25px;
    }

    .dashboard-mobile-header button {
        width: 40px;
        height: 40px;
        border: 1px solid #e5e7eb;
        border-radius: 9px;
        background: #ffffff;
        cursor: pointer;
        font-size: 19px;
    }

    .dashboard-heading {
        align-items: flex-start;
    }

}


@media (max-width: 600px) {

    .dashboard-main {
        padding: 20px 15px;
    }

    .dashboard-heading {
        flex-direction: column;
        align-items: stretch;
        margin-bottom: 25px;
    }

    .dashboard-heading h1 {
        font-size: 27px;
    }

    .dashboard-heading .primary-btn {
        width: 100%;
    }

    .dashboard-stats {
        grid-template-columns: 1fr;
        gap: 10px;
    }

    .dashboard-service-grid {
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .dashboard-service-card {
        padding: 16px;
    }

    .dashboard-service-icon {
        width: 40px;
        height: 40px;
        font-size: 17px;
    }

    .section-title-row {
        align-items: flex-end;
    }

    .section-title-row h2 {
        font-size: 16px;
    }

    .section-title-row > a {
        white-space: nowrap;
    }

    .orders-empty {
        padding: 40px 15px;
    }

}
